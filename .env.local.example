# Optional. Copy to .env.local and fill in. Users can also enter their own key in the app
# (Settings → Jev API key); a key entered there takes precedence over this one.
# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Set to "mock" to always use the local trigram model and ignore all keys.
# JEV_BACKEND=mock

# Optional: pin a Jev version instead of jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

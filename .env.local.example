# Optional. Copy to .env.local and fill in.
# Used only by `npm run smoke` and `npm run eval`. The chat never uses this key: every visitor
# must enter their own in the app. Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Set to "mock" to always use the local trigram model and ignore all keys (the chat then works
# without a key; handy for local UI work).
# JEV_BACKEND=mock

# Optional: serve the app under a sub-path, e.g. https://example.com/jevgpt. Needed at build time
# and by `npm start`; rebuild after changing it. Leave unset to serve at the root.
# NEXT_PUBLIC_BASE_PATH=/jevgpt

# Optional: pin a Jev version instead of jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
